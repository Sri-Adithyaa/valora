# ─── Valora Money — environment template ───────────────────────────────
# Copy to `.env` (never commit the real file) and adjust as needed.

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_USER=valora
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=valora
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://valora:change-me-locally@localhost:5433/valora

# Separate database used by the automated test-suite (created automatically)
TEST_DATABASE_URL=postgresql+psycopg://valora:change-me-locally@localhost:5433/valora_test

# Auth — generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=720
COOKIE_SECURE=false

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Simulation settings
INITIAL_FUNDING_INR=100000
DEMO_FUNDING_MAX_PER_REQUEST_INR=500000
DEMO_FUNDING_DAILY_LIMIT_INR=1000000
TRADING_FEE_RATE=0.0025
QUOTE_VALIDITY_SECONDS=30
MAX_QUOTE_RATE_AGE_HOURS=72

# Market-rate worker
RATE_UPDATE_INTERVAL_SECONDS=120
# Comma-separated fallback chain: coinbase, open_er_api, simulated
RATE_PROVIDERS=coinbase,open_er_api
RATE_PROVIDER_TIMEOUT_SECONDS=10
RATE_PROVIDER_RETRIES=3
RATE_MAX_JUMP_PCT=15
